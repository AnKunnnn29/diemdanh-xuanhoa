# Server-only configuration. Copy to .env.cloud.local (ignored by Git).
# Supabase -> Connect -> Transaction pooler -> URI. URL-encode the DB password.
# Never prefix these with NEXT_PUBLIC_, VITE_, or PUBLIC_.
XH_DATABASE_URL=
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
XH_SESSION_SECRET=
# HTTPS origin without a trailing slash. On Vercel, VERCEL_URL is also accepted.
XH_PUBLIC_ORIGIN=
# Optional CA file to enable sslmode=verify-full. Package the public CA on the server.
XH_DATABASE_CA_FILE=
# Separate credentials for the local/maintenance tools; never supply to the frontend.
XH_BACKUP_DATABASE_URL=
XH_RESTORE_DATABASE_URL=
# Files are stored privately in PostgreSQL, deduplicated by SHA-256.
# No Supabase Storage key is required for this trial deployment.
