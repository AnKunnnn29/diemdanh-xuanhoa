# Server environment only; do not put credentials in app.js or commit a real .env.
# Leaving XH_MYSQL_DATABASE unset uses the existing local attendance.sqlite3.
# A .env file is not loaded automatically; configure these in the host/process environment.
XH_MYSQL_HOST=127.0.0.1
XH_MYSQL_PORT=3306
XH_MYSQL_DATABASE=
XH_MYSQL_USER=
XH_MYSQL_PASSWORD=
# Optional path to the CA certificate supplied by your managed MySQL provider.
XH_MYSQL_SSL_CA=
